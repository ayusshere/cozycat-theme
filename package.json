{
  "name": "cozycat",
  "displayName": "CozyCat Theme",
  "publisher": "cozy-cat",
  "description": "CozyCat: a calm and elegant theme for long coding sessions.",
  "version": "1.1.5",
  "engines": {
    "vscode": "^1.106.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayusshere/cozycat-theme.git"
  },
  "icon": "icon/icon.png",
  "categories": ["Themes"],

  "contributes": {
    "themes": [
      {
        "label": "CozyCat Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/cozycat-dark.json"
      },
      {
        "label": "CozyCat Light",
        "uiTheme": "vs-light",
        "path": "./themes/cozycat-light.json"
      }
    ]
  },

  "dependencies": {
    "vsce": "^2.15.0"
  }
}